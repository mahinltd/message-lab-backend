# App
NODE_ENV=development
PORT=5000
API_URL=http://localhost:5000
FRONTEND_URL=http://localhost:3000
ADMIN_URL=http://localhost:3000

# Database
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/MessageLab?retryWrites=true&w=majority
MONGO_DNS_SERVERS=1.1.1.1,8.8.8.8

# Security Secrets (use unique values of at least 32 characters)
SESSION_SECRET=replace-with-a-random-secret-at-least-32-characters
COOKIE_SECRET=replace-with-a-random-secret-at-least-32-characters
JWT_ACCESS_SECRET=replace-with-a-random-secret-at-least-32-characters
JWT_REFRESH_SECRET=replace-with-a-random-secret-at-least-32-characters

# Upstash Redis
UPSTASH_REDIS_REST_URL=https://your-upstash-instance.upstash.io
UPSTASH_REDIS_REST_TOKEN=your-upstash-rest-token
UPSTASH_REDIS_URL=https://your-upstash-instance.upstash.io

# Resend Email
RESEND_API_KEY=your-resend-api-key
# Email Senders
EMAIL_FROM_VERIFY=verify@example.com
EMAIL_FROM_NO_REPLY=no-reply@example.com
EMAIL_FROM_UPDATE=update@example.com
EMAIL_FROM_BILLING=billing@example.com
EMAIL_FROM_SUPPORT=support@example.com

# Email Verification
EMAIL_VERIFICATION_TOKEN_EXPIRY_HOURS=24
EMAIL_VERIFICATION_RESEND_COOLDOWN_MINUTES=5

# Cloudinary
CLOUDINARY_CLOUD_NAME=your-cloudinary-cloud-name
CLOUDINARY_API_KEY=your-cloudinary-api-key
CLOUDINARY_API_SECRET=your-cloudinary-api-secret
CLOUDINARY_FOLDER=MessageLab

# Google OAuth
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret
GOOGLE_CALLBACK_URL=http://localhost:5000/api/v1/auth/google/callback

# SMS Plan Defaults
SMS_MIN_DELAY_MS=3000
FREE_PLAN_MAX_RECIPIENTS=10
PRO_PLAN_MAX_RECIPIENTS=20

# Rate Limiting Defaults
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=300
